/* ========== 地图主页样式 · 约个地儿 v2 ========== */

.page-map { position: relative; width: 100vw; height: 100vh; overflow: hidden; }
.full-map { width: 100%; height: 100%; }

/* ==================================================================
   顶部状态栏 — meet-bar 药丸造型，与胶囊按钮同行同高
   ================================================================== */
.meet-bar {
  position: fixed;
  left: 24rpx;
  z-index: 100;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 16rpx;
  gap: 0;
}

.mb-back {
  font-size: 36rpx;
  color: #111827;
  font-weight: 500;
  margin-right: 16rpx;
  line-height: 1;
  flex-shrink: 0;
}

.mb-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: #10B981;
  box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.2);
  margin-right: 12rpx;
  flex-shrink: 0;
  animation: pulse-dot 2s infinite;
}
@keyframes pulse-dot {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(16, 185, 129, 0.2); }
  50% { box-shadow: 0 0 0 8rpx rgba(16, 185, 129, 0.05); }
}

.mb-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.mb-divider {
  width: 2rpx; height: 24rpx;
  background: rgba(0, 0, 0, 0.1);
  margin: 0 20rpx;
  flex-shrink: 0;
}

.mb-users {
  display: flex; align-items: center; gap: 8rpx;
}
.mb-users-icon {
  width: 28rpx; height: 28rpx;
}
.mb-users-count {
  font-size: 26rpx;
  font-weight: 700;
  color: #4A7FE5;
  line-height: 1;
  white-space: nowrap;
}

/* ==================================================================
   右侧工具栏 — toolbox 毛玻璃白底卡片
   ================================================================== */
.toolbox {
  position: fixed;
  z-index: 100;
  width: 96rpx;
  background: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
}

.tb-item {
  width: 100%;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tb-item-hover {
  background: rgba(0, 0, 0, 0.04);
}

.tb-icon {
  width: 44rpx; height: 44rpx;
  flex-shrink: 0;
}

.tb-text {
  font-size: 20rpx;
  color: #555555;
  font-weight: 500;
  line-height: 1;
}

.tb-divider {
  width: 64rpx;
  height: 1rpx;
  background: rgba(0, 0, 0, 0.06);
  margin: 0 auto;
}

/* 分享按钮清除 button 默认样式 */
.tb-share-btn {
  margin: 0; border: none;
  background: transparent;
  line-height: normal;
  width: 100%;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}
.tb-share-btn::after { border: none; }

/* ==================================================================
   底部碰面地点浮动卡片 — 圆角浮动，bottom: safe-area + 24rpx
   ================================================================== */
.meet-card {
  position: fixed;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  left: 24rpx; right: 24rpx;
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255,255,255,0.96);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.10);
}

.mc-left {
  display: flex; align-items: center; gap: 16rpx;
  flex: 1; min-width: 0;
}
.mc-icon {
  width: 44rpx; height: 44rpx; flex-shrink: 0;
}
.mc-icon-text {
  font-size: 40rpx; flex-shrink: 0; line-height: 1;
}
.mc-info {
  display: flex; flex-direction: column; min-width: 0;
}
.mc-label {
  font-size: 20rpx; color: var(--c-text3); font-weight: 500;
  line-height: 1.2;
}
.mc-name {
  font-size: 28rpx; font-weight: 600; color: var(--c-text);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mc-arrow {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
}
.mc-arrow-text {
  font-size: 36rpx; color: var(--c-text3); font-weight: 300;
}

/* ==================================================================
   面板通用 — 增加 head-row（标题 + 关闭按钮）
   ================================================================== */
.panel-head-row {
  display: flex; align-items: flex-start; justify-content: space-between;
  margin-bottom: 8rpx;
}

/* ==================================================================
   面板通用 — 缩小态（panel-mini）
   ================================================================== */
.panel-mini {
  max-height: none !important;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)) !important;
  overflow: hidden;
}
.panel-mini-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.panel-mini-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 16rpx;
}
.panel-mini-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}
.panel-expand-btn {
  width: 48rpx; height: 48rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: var(--c-bg);
}
.panel-title { font-size: 34rpx; font-weight: 700; color: var(--c-text); margin-bottom: 0; }
.panel-close {
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; color: var(--c-text3);
  border-radius: 50%;
  background: var(--c-bg);
  flex-shrink: 0;
  transition: background 0.15s;
}
.panel-close:active { background: var(--c-border); }

.panel-desc { font-size: 24rpx; color: var(--c-text3); margin-bottom: 24rpx; line-height: 1.5; }

/* ==================================================================
   搜索
   ================================================================== */
.search-row { display: flex; gap: 12rpx; margin-bottom: 20rpx; }
.search-input {
  flex: 1; height: 76rpx; background: var(--c-bg);
  border-radius: var(--r-md); padding: 0 24rpx;
  font-size: 28rpx;
  border: 2rpx solid var(--c-border);
  transition: border-color 0.2s;
}
.search-input:focus { border-color: var(--c-primary); }
.search-btn {
  width: 120rpx; height: 76rpx;
  background: var(--c-primary); color: #FFF;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); font-size: 28rpx; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(74,127,229,0.25);
}
.search-results-wrap { max-height: 400rpx; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.search-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-border);
  transition: background 0.15s;
}
.search-item:active { background: var(--c-bg); }
.si-name { font-size: 28rpx; font-weight: 600; color: var(--c-text); display: block; }
.si-addr { font-size: 22rpx; color: var(--c-text3); margin-top: 6rpx; display: block; }

.friend-name-section {
  display: flex; flex-direction: column; gap: 8rpx;
  margin-bottom: 20rpx;
}
.fn-section-label {
  font-size: 26rpx; color: var(--c-text2); font-weight: 600;
}
.friend-name-row {
  display: flex; flex-direction: column; gap: 16rpx;
  padding: 24rpx 0;
}
.fn-label {
  font-size: 26rpx; color: var(--c-primary); font-weight: 500;
  display: flex; align-items: center; gap: 6rpx;
}
.friend-name-input { height: 76rpx; }
.friend-confirm-row {
  display: flex; flex-direction: column; gap: 16rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--c-border-lt);
}
.pick-hint { text-align: center; font-size: 24rpx; color: var(--c-text3); padding: 40rpx 0; }

/* 添加好友面板 — 分享邀请区域 */
/* ==================================================================
   添加好友面板 - 主推：邀请好友加入碰头（蓝色一体卡片）
   ================================================================== */
.invite-section-btn {
  display: block !important;
  box-sizing: border-box !important;
  width: 100% !important;
  max-width: none !important;
  min-width: 0 !important;
  min-height: 0 !important;
  padding: 0 !important;
  margin: 16rpx 0 0 !important;
  background: transparent !important;
  border: none !important;
  line-height: normal !important;
  border-radius: 24rpx;
  overflow: hidden;
  text-align: left;
}
.invite-section-btn::after { border: none !important; }
.invite-section-btn-hover {
  opacity: 0.92;
}
.invite-section {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: #3B82F6;
  color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.25);
}
.invite-icon-circle {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.invite-icon-plus {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1;
}
.invite-section-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  text-align: left;
  min-width: 0;
}
.invite-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  line-height: 1.3;
}
.invite-section-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.4;
}

/* ==================================================================
   添加好友面板 - 次要：手动标记好友位置（浅灰常驻卡片）
   ================================================================== */
.manual-section {
  background: #F9FAFB;
  padding: 32rpx;
  border-radius: 24rpx;
  margin-top: 24rpx;
}
.manual-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  display: block;
  margin-bottom: 20rpx;
}
.manual-input {
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid #D1D5DB;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #111827;
  box-sizing: border-box;
}
.manual-input-full {
  width: 100%;
  margin-bottom: 16rpx;
}
.manual-input-flex {
  flex: 1;
}
.manual-input-group {
  display: flex;
  gap: 16rpx;
}
.manual-search-btn {
  height: 80rpx;
  line-height: 80rpx;
  background: #3B82F6;
  color: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  flex-shrink: 0;
}
.manual-search-btn-hover {
  background: #2563EB;
}

/* ==================================================================
   旧的 panel-share-section（保留以防其他地方引用，但不再使用）
   ================================================================== */
.panel-share-section {
  margin-top: 24rpx;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.panel-share-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  margin-bottom: 24rpx;
}
.panel-share-line {
  flex: 1;
  height: 1rpx;
  background: #E5E7EB;
}
.panel-share-or {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 500;
  white-space: nowrap;
}
.btn-share-invite {
  width: 100%;
  height: 88rpx;
  background: #EBF2FF;
  color: #4A7FE5;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin: 0;
  line-height: 88rpx;
}
.btn-share-invite::after { border: none; }
.btn-share-invite:active {
  background: #D6E4FF;
}
.btn-share-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
}
.btn-share-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  display: block;
}
.panel-share-tip {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
}

/* ==================================================================
   类型标签
   ================================================================== */
.type-scroll { margin-bottom: 20rpx; white-space: nowrap; }
.type-tags { display: flex; gap: 12rpx; padding: 4rpx 0; }
.type-tag {
  display: inline-flex; align-items: center;
  padding: 12rpx 28rpx;
  background: var(--c-card);
  border: 2rpx solid var(--c-border);
  border-radius: var(--r-full);
  font-size: 26rpx; color: var(--c-text2);
  white-space: nowrap; flex-shrink: 0;
  transition: all 0.2s;
}
.type-tag-active {
  background: var(--c-primary);
  color: #FFF;
  border-color: var(--c-primary);
}
.type-tag-active .cat-icon {
  filter: brightness(0) invert(1);
}

/* ==================================================================
   推荐列表 — 半屏可下拉面板
   ================================================================== */
.panel-recommend-wrap {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 200;
  background: var(--c-card);
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -8rpx 48rpx rgba(0,0,0,0.12);
  padding: 0 32rpx calc(24rpx + env(safe-area-inset-bottom));
  max-height: 55vh;
  animation: slideUp 0.3s ease;
  transition: max-height 0.3s ease;
}
.panel-recommend-wrap .panel-handle-bar {
  padding: 16rpx 0 8rpx;
  display: flex; justify-content: center;
}
.panel-recommend-wrap .panel-handle {
  width: 72rpx; height: 8rpx;
  background: #D1D5DB; border-radius: 4rpx;
  margin: 0;
}
.panel-recommend-wrap .panel-head-row {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 12rpx;
}
.panel-recommend-wrap .panel-title {
  font-size: 34rpx; font-weight: 700; color: var(--c-text);
}
.collapse-icon { font-size: 22rpx; color: var(--c-text3); }

.panel-recommend-wrap .recommend-list-wrap {
  max-height: 35vh;
  -webkit-overflow-scrolling: touch;
}

/* 折叠态 — 与其他面板一致的缩小态 */
.panel-recommend-collapsed {
  max-height: none !important;
  padding: 0 32rpx calc(20rpx + env(safe-area-inset-bottom)) !important;
}
.panel-recommend-collapsed .panel-handle-bar {
  padding: 12rpx 0 4rpx;
}

.recommend-list-wrap { max-height: 50vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.rec-item {
  display: flex; align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--c-border-lt);
  transition: background 0.15s;
}
.rec-item:active { background: var(--c-bg); }
.rec-rank {
  width: 48rpx; height: 48rpx;
  background: var(--c-primary-bg); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; font-weight: 700; color: var(--c-primary);
  margin-right: 16rpx; flex-shrink: 0;
}
.rec-info { flex: 1; min-width: 0; }
.rec-name { font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.rec-meta { display: flex; align-items: center; gap: 12rpx; margin-top: 6rpx; }
.rec-type { font-size: 22rpx; color: var(--c-primary); font-weight: 500; }
.rec-rating { font-size: 22rpx; color: var(--c-warning); }
.rec-dist { font-size: 22rpx; color: var(--c-text3); }
.rec-addr { font-size: 22rpx; color: var(--c-text3); margin-top: 4rpx; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.rec-action { flex-shrink: 0; margin-left: 12rpx; }
.btn-set-meet {
  font-size: 22rpx; color: var(--c-primary); font-weight: 600;
  padding: 10rpx 24rpx;
  border: 2rpx solid var(--c-primary);
  border-radius: var(--r-full);
  transition: all 0.2s;
}
.btn-set-meet:active { background: var(--c-primary); color: #FFF; }
.loading-hint { text-align: center; color: var(--c-text3); padding: 40rpx; font-size: 26rpx; }
.empty-hint { text-align: center; color: var(--c-text3); padding: 40rpx; font-size: 26rpx; }

/* ==================================================================
   用户面板
   ================================================================== */
.panel-user { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.user-panel-content { display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }

/* 「参与智能推荐」开关行 */
.up-recommend-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  background: #F8FAFC;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}
.up-recommend-info { flex: 1; min-width: 0; }
.up-recommend-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 6rpx;
}
.up-recommend-desc {
  display: block;
  font-size: 24rpx;
  color: #6B7280;
}
.up-toggle {
  width: 80rpx;
  height: 44rpx;
  border-radius: 22rpx;
  position: relative;
  flex-shrink: 0;
  transition: background 0.2s ease;
}
.up-toggle-on { background: #3B82F6; }
.up-toggle-off { background: #D1D5DB; }
.up-toggle-knob {
  position: absolute;
  top: 4rpx;
  width: 36rpx;
  height: 36rpx;
  background: #FFFFFF;
  border-radius: 50%;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.15);
  transition: left 0.2s ease;
}
.up-toggle-on .up-toggle-knob { left: 40rpx; }
.up-toggle-off .up-toggle-knob { left: 4rpx; }

/* 头像容器 */
.up-avatar-wrap {
  position: relative;
  width: 96rpx; height: 96rpx;
  flex-shrink: 0;
}
/* 用户面板关闭按钮行 */
.up-close-row {
  display: flex; align-items: center; justify-content: flex-end;
  margin-bottom: 8rpx;
}
.up-avatar {
  width: 96rpx; height: 96rpx; border-radius: 50%;
  background: var(--c-primary-bg);
  border: 4rpx solid var(--c-primary);
  flex-shrink: 0;
}
.up-avatar-self { border-color: #4A7FE5; }
.up-avatar-online { border-color: #2ECC71; }
.up-avatar-offline {
  border-color: #BFBFBF;
}
/* 离线头像蒙层容器 */
.up-avatar-wrap-offline {
  position: relative;
}
.up-avatar-wrap-offline::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  background: rgba(150, 150, 150, 0.45);
  z-index: 1;
}
.up-avatar-manual {
  border-color: #D0D0D0;
  background: #F0F0F0;
}

.up-status-dot {
  position: absolute;
  right: 2rpx; bottom: 2rpx;
  width: 22rpx; height: 22rpx;
  border-radius: 50%;
  border: 3rpx solid #FFFFFF;
  z-index: 2;
}
.up-dot-online { background: #2ECC71; }
.up-dot-offline { background: #BFBFBF; }


.up-info { flex: 1; }
.up-name-row { display: flex; align-items: center; gap: 10rpx; }
.up-name { font-size: 32rpx; font-weight: 700; color: var(--c-text); }
.up-location {
  font-size: 24rpx; color: var(--c-text3); margin-top: 6rpx;
  display: flex; align-items: center; gap: 4rpx;
}
.up-tag { margin-top: 0; }
.tag-blue {
  background: rgba(74,127,229,0.1);
  color: #4A7FE5;
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: var(--r-full);
  font-weight: 600;
}

.up-status-row {
  display: flex; align-items: center; gap: 8rpx; margin-top: 8rpx;
}
.up-status-indicator {
  width: 14rpx; height: 14rpx;
  border-radius: 50%;
}
.up-ind-online { background: #2ECC71; }
.up-ind-offline { background: #BFBFBF; }
.up-status-text { font-size: 22rpx; font-weight: 500; }
.up-text-online { color: #2ECC71; }
.up-text-offline { color: #999; }
.up-offline-time { font-size: 22rpx; color: #BFBFBF; }

/* ==================================================================
   地点面板
   ================================================================== */
.panel-place { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.pp-header { margin-bottom: 16rpx; }
.pp-name { font-size: 36rpx; font-weight: 700; color: var(--c-text); display: block; margin-bottom: 10rpx; }
.pp-type-row { display: flex; align-items: center; gap: 12rpx; }
.pp-rating { font-size: 24rpx; color: var(--c-warning); font-weight: 600; }
.pp-detail { margin-bottom: 20rpx; }
.pp-row { display: flex; gap: 8rpx; padding: 10rpx 0; align-items: flex-start; }
.pp-label { font-size: 24rpx; color: var(--c-text3); flex-shrink: 0; display: flex; align-items: center; gap: 4rpx; }
.pp-value { font-size: 24rpx; color: var(--c-text); flex: 1; }
.pp-tel { color: var(--c-primary); }
.pp-photos { white-space: nowrap; margin-bottom: 20rpx; }
.pp-photo {
  width: 200rpx; height: 150rpx; border-radius: var(--r-md);
  margin-right: 12rpx; display: inline-block;
}

/* ==================================================================
   面板操作按钮
   ================================================================== */
.panel-actions {
  display: flex; gap: 16rpx; margin-top: 20rpx;
}
.panel-actions .btn-sm { flex: 1; }
/* 地点面板：导航按钮占 1 份，设为碰面地点按钮占 2 份 */
.panel-place .panel-actions .btn-green { flex: 1; }
.panel-place .panel-actions .btn-set,
.panel-place .panel-actions .btn-del { flex: 2; }

/* 地点面板 — 设为好友位置 */
.pp-friend-section {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--c-border);
}
.pp-friend-row {
  display: flex; gap: 16rpx; align-items: center;
}
/* 输入框占 1 份，按钮占 2 份，与上方按钮比例一致 */
.pp-friend-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  border: 2rpx solid var(--c-border);
  border-radius: var(--r-md);
  background: var(--c-bg);
  color: var(--c-text);
}
.btn-friend-add {
  flex: 2;
  min-width: 0;
  font-size: 24rpx;
  padding: 0 20rpx;
  height: 68rpx;
  line-height: 68rpx;
  background: var(--c-primary-bg);
  color: var(--c-primary);
  border-radius: var(--r-md);
  white-space: nowrap;
}
.btn-route {
  margin-top: 20rpx;
  background: var(--c-primary-bg);
  color: var(--c-primary);
  font-size: 26rpx;
  border-radius: var(--r-md);
}
.btn-set {
  background: var(--c-primary-bg); color: var(--c-primary);
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
}
.btn-icon-img {
  width: 32rpx; height: 32rpx;
  flex-shrink: 0;
}
.btn-del {
  background: rgba(231,76,60,0.08); color: var(--c-danger);
}

/* ==================================================================
   路线信息
   ================================================================== */
.routes-info { margin-top: 24rpx; padding-top: 24rpx; border-top: 1rpx solid var(--c-border); }
.mock-route-tip {
  padding: 16rpx 20rpx;
  background: rgba(243,156,18,0.08);
  border-radius: var(--r-sm);
  margin-bottom: 16rpx;
}
.mrt-text { font-size: 22rpx; color: #B87A00; line-height: 1.6; }
.routes-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.routes-title { font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.route-mode-switch {
  display: flex; align-items: center;
  padding: 8rpx 20rpx;
  background: var(--c-primary-bg);
  border-radius: var(--r-full);
  transition: all 0.2s;
}
.route-mode-switch:active { background: rgba(74,127,229,0.2); }
.rms-text { font-size: 22rpx; color: var(--c-primary); font-weight: 600; }
.route-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--c-border-lt);
}
.route-item:last-child { border-bottom: none; }
.ri-name { flex: 1; font-size: 26rpx; color: var(--c-text2); }
.ri-dist { font-size: 26rpx; font-weight: 600; color: var(--c-primary); }
.ri-time { font-size: 24rpx; color: var(--c-text3); }

/* ==================================================================
   测试工具面板
   ================================================================== */
.panel-test { max-height: 70vh; }
.test-batch-row {
  display: flex; gap: 16rpx; margin-bottom: 24rpx;
}
.test-batch-btn {
  flex: 1; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: var(--r-md); font-size: 26rpx; font-weight: 600;
  transition: opacity 0.2s;
}
.test-batch-btn:active { opacity: 0.8; }
.test-add-all { background: var(--c-primary-bg); color: var(--c-primary); }
.test-remove-all { background: rgba(231,76,60,0.08); color: var(--c-danger); }
.test-user-list { max-height: 50vh; overflow-y: auto; -webkit-overflow-scrolling: touch; }
.test-user-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--c-border-lt);
}
.tu-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--c-primary-bg);
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}
.tu-info { flex: 1; min-width: 0; }
.tu-name { font-size: 28rpx; font-weight: 600; color: var(--c-text); display: block; }
.tu-pos { font-size: 20rpx; color: var(--c-text3); margin-top: 4rpx; display: block; font-family: monospace; }
.tu-action { flex-shrink: 0; }
.tu-btn {
  padding: 10rpx 28rpx;
  border-radius: var(--r-full);
  font-size: 24rpx; font-weight: 600;
  transition: all 0.2s;
}
.tu-btn:active { opacity: 0.8; }
.tu-btn-add { background: var(--c-primary); color: #FFF; box-shadow: 0 4rpx 12rpx rgba(74,127,229,0.25); }
.tu-btn-remove { background: rgba(231,76,60,0.08); color: var(--c-danger); }

/* ==================================================================
   通用图标尺寸类
   ================================================================== */
.icon-xs       { width: 24rpx; height: 24rpx; vertical-align: middle; }
.icon-xs-sm    { width: 28rpx; height: 28rpx; vertical-align: middle; }
.icon-sm       { width: 32rpx; height: 32rpx; vertical-align: middle; }
.icon-close    { width: 28rpx; height: 28rpx; }
.btn-icon-sm   { width: 28rpx; height: 28rpx; vertical-align: middle; margin-right: 4rpx; }
.btn-icon-lg   { width: 36rpx; height: 36rpx; vertical-align: middle; margin-right: 8rpx; }
.cat-icon      { width: 32rpx; height: 32rpx; vertical-align: middle; margin-right: 6rpx; }

/* 绿色按钮内的图标改为白色 */
.btn-green .btn-icon-sm,
.btn-green .btn-icon-lg {
  filter: brightness(0) invert(1);
}
