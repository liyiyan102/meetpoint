/* ========================================
   今日去哪玩 · 蓝色品牌风格
   与约个地儿 app.wxss 设计令牌保持一致
   品牌色 #4A7FE5 / 页面底 #F5F7FA / 卡片 #fff
   ======================================== */

.app {
  min-height: 100vh;
  background: #F5F7FA;
}

/* 自定义导航栏（蓝色背景，无分割线） */
.nav-bar {
  height: 88rpx;
  background: #4A7FE5;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

/* ========== 环境卡片 ========== */
.env {
  background: linear-gradient(160deg, #4A7FE5 0%, #6B9BF2 100%);
  padding: 48rpx 48rpx 40rpx;
  position: relative;
  overflow: hidden;
  color: #fff;
}
.env::before {
  content: "";
  position: absolute;
  top: -80rpx; right: -60rpx;
  width: 360rpx; height: 360rpx;
  background: #6B9BF2;
  opacity: .25;
  border-radius: 50%;
}
.env-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 2;
}
.env-title {
  font-size: 52rpx;
  font-weight: 900;
  letter-spacing: -2rpx;
  margin-bottom: 12rpx;
  color: #fff;
}
.env-loc { font-size: 26rpx; color: rgba(255,255,255,.75); }
.env-right { text-align: right; }
.env-temp { font-size: 72rpx; font-weight: 900; line-height: 1; color: #fff; }
.env-desc { font-size: 24rpx; color: rgba(255,255,255,.75); margin-top: 8rpx; }
.env-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
  position: relative;
  z-index: 2;
}
.tag {
  background: rgba(255,255,255,.2);
  padding: 12rpx 24rpx;
  border-radius: 40rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
}
.tag.yi { background: rgba(46,204,113,.3); color: #fff; }
.tag.ji { background: rgba(250,81,81,.3); color: #fff; }

/* ========== 表单区 ========== */
.form { padding: 48rpx; }
.form-h2 {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  color: #1A1A2E;
}
.form-h2 .n { color: #4A7FE5; margin-right: 8rpx; }
.form-block { margin-bottom: 44rpx; }
.form-block.opt {
  margin-bottom: 36rpx;
  padding-bottom: 36rpx;
  border-bottom: 2rpx dashed #E5E7EB;
}
.opt-tag {
  font-size: 22rpx;
  font-weight: 700;
  color: #9CA3AF;
  background: #F5F7FA;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 12rpx;
}

/* Chips */
.chips { display: flex; gap: 16rpx; flex-wrap: wrap; }
.chip {
  flex: 1;
  min-width: 160rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  background: #FFFFFF;
  border: 4rpx solid #E5E7EB;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #6B7280;
  transition: .15s;
}
.chip.active {
  background: #4A7FE5;
  color: #fff;
  border-color: #4A7FE5;
  box-shadow: 0 8rpx 24rpx rgba(74,127,229,.3);
}
.chip-ico { font-size: 44rpx; display: block; margin-bottom: 4rpx; }

/* 日期 */
.date-input {
  width: 100%;
  padding: 28rpx 80rpx 28rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #FFFFFF;
  border: 4rpx solid #E5E7EB;
  border-radius: 28rpx;
  color: #1A1A2E;
}
.date-quick {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  flex-wrap: wrap;
}
.date-chip {
  flex: none;
  padding: 14rpx 24rpx;
  font-size: 25rpx;
  border-radius: 36rpx;
  background: #fff;
  border: 2rpx solid #E5E7EB;
  color: #6B7280;
}
.date-chip.active {
  background: #4A7FE5;
  color: #fff;
  border-color: #4A7FE5;
}
.date-info {
  margin-top: 20rpx;
  padding: 20rpx 28rpx;
  background: #EBF2FF;
  border-radius: 28rpx;
  font-size: 25rpx;
  color: #1A1A2E;
}
.di-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}
.di-row + .di-row { margin-top: 8rpx; }
.di-label { color: #6B7280; font-weight: 600; }
.di-val { font-weight: 700; color: #1A1A2E; }
.di-yi { color: #2ECC71; font-weight: 700; }
.di-ji { color: #FA5151; font-weight: 700; }

/* 下拉 */
.select-input {
  width: 100%;
  padding: 28rpx 80rpx 28rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #FFFFFF;
  border: 4rpx solid #E5E7EB;
  border-radius: 28rpx;
  color: #1A1A2E;
  position: relative;
}
.select-input::after {
  content: "";
  position: absolute;
  right: 36rpx; top: 50%;
  transform: translateY(-65%) rotate(45deg);
  width: 16rpx; height: 16rpx;
  border-right: 4rpx solid #9CA3AF;
  border-bottom: 4rpx solid #9CA3AF;
}

/* 玄学解读徽章 */
.reading-badge {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 14rpx 28rpx;
  font-size: 25rpx;
  font-weight: 800;
  border-radius: 40rpx;
}
.reading-badge.mystic {
  background: linear-gradient(90deg, #2d1b4e, #5B4FFF 60%, #FF2E93);
  color: #fff;
  box-shadow: 0 8rpx 28rpx rgba(91,79,255,.45);
}
.rb-icon { font-size: 28rpx; }

/* CTA */
.cta-btn {
  width: 100%;
  padding: 36rpx;
  background: linear-gradient(90deg, #4A7FE5, #6B9BF2);
  color: #fff;
  border: none;
  border-radius: 120rpx;
  font-size: 34rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  box-shadow: 0 16rpx 48rpx rgba(74,127,229,.35);
  margin-top: 16rpx;
}
.cta-btn::after { border: none; }
.cta-btn[disabled] { opacity: .5; }

/* ========== 加载态 ========== */
.loading {
  padding: 80rpx 48rpx;
  text-align: center;
}
.loading-dots {
  font-size: 48rpx;
  color: #4A7FE5;
  letter-spacing: 16rpx;
}
.dot {
  display: inline-block;
  animation: pulse 1.4s infinite;
}
.dot:nth-child(2) { animation-delay: .2s; }
.dot:nth-child(3) { animation-delay: .4s; }
@keyframes pulse { 0%,100% { opacity: .3; } 50% { opacity: 1; } }
.loading-txt {
  color: #6B7280;
  font-size: 26rpx;
  margin-top: 24rpx;
  line-height: 1.7;
}

/* ========== 结果卡片 ========== */
.result { padding: 0 48rpx 48rpx; }
.result-card {
  background: #FFFFFF;
  border-radius: 40rpx;
  padding: 40rpx;
  border: 4rpx solid #EBF2FF;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.result-badge {
  position: absolute;
  top: -20rpx; left: 40rpx;
  background: #4A7FE5;
  color: #fff;
  padding: 8rpx 28rpx;
  border-radius: 40rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}
.result-place {
  font-size: 44rpx;
  font-weight: 900;
  margin-top: 16rpx;
  margin-bottom: 24rpx;
  letter-spacing: -1rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #1A1A2E;
}
.place-link {
  color: #4A7FE5;
  border-bottom: 4rpx dashed #4A7FE5;
  padding-bottom: 4rpx;
}
.link-ico { font-size: 28rpx; color: #4A7FE5; }
.result-meta {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
  margin-bottom: 32rpx;
}
.meta-span {
  background: #F5F7FA;
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6B7280;
  border: 2rpx solid #E5E7EB;
}
.why-box {
  background: #F5F7FA;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.box-title {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-bottom: 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.why-item {
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1A2E;
  padding-left: 32rpx;
  position: relative;
}
.why-item::before {
  content: "·";
  position: absolute;
  left: 0;
  color: #4A7FE5;
  font-weight: 900;
}

.hl-box {
  background: #F5F7FA;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 32rpx;
}
.hl-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 2rpx dashed #E5E7EB;
  font-size: 26rpx;
  gap: 16rpx;
}
.hl-item:last-child { border: none; }
.hl-name { font-weight: 700; color: #1A1A2E; flex: 1; }
.link-ico-sm { font-size: 22rpx; color: #4A7FE5; margin-left: 6rpx; }
.hl-tag { color: #4A7FE5; font-size: 24rpx; flex-shrink: 0; }

.tip-line {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.actions-col {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.actions-row {
  display: flex;
  gap: 20rpx;
}
.btn-sec {
  flex: 1;
  padding: 28rpx;
  background: #fff;
  border: 4rpx solid #4A7FE5;
  color: #4A7FE5;
  border-radius: 80rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
}
.btn-sec::after { border: none; }
.btn-pri {
  width: 100%;
  padding: 28rpx;
  background: #4A7FE5;
  color: #fff;
  border: 4rpx solid #4A7FE5;
  border-radius: 80rpx;
  font-size: 28rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin: 0;
  line-height: 1.2;
}
.btn-pri::after { border: none; }

/* ========== 海报弹层 ========== */
.poster-overlay {
  position: fixed;
  inset: 0;
  background: rgba(10,5,20,.8);
  z-index: 999;
  display: none;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}
.poster-overlay.show { display: flex; }
.poster-modal {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
  max-height: 92vh;
}
.poster-wrap {
  max-height: 78vh;
  overflow-y: auto;
  border-radius: 52rpx;
  box-shadow: 0 48rpx 120rpx rgba(0,0,0,.5);
}
.poster-wrap::-webkit-scrollbar { display: none; }

.poster-card {
  width: 640rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(165deg, #1a0b2e 0%, #2d1b4e 48%, #1a0b2e 100%);
  padding: 56rpx 44rpx 44rpx;
  color: #fff;
}
.poster-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(84rpx);
  z-index: 0;
}
.blob1 { width: 380rpx; height: 380rpx; background: #4A7FE5; top: -140rpx; right: -120rpx; opacity: .55; }
.blob2 { width: 340rpx; height: 340rpx; background: #6B9BF2; bottom: 140rpx; left: -140rpx; opacity: .5; }
.blob3 { width: 260rpx; height: 260rpx; background: #00E5B0; bottom: -100rpx; right: 20rpx; opacity: .35; }

.poster-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 2;
  margin-bottom: 32rpx;
}
.poster-brand {
  font-size: 24rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  background: rgba(255,255,255,.14);
  padding: 8rpx 20rpx;
  border-radius: 40rpx;
}
.poster-date { font-size: 23rpx; color: rgba(255,255,255,.55); font-weight: 600; }

.poster-badge {
  display: inline-block;
  background: linear-gradient(90deg, #4A7FE5, #6B9BF2);
  color: #fff;
  font-size: 24rpx;
  font-weight: 900;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  margin-bottom: 24rpx;
  position: relative;
  z-index: 2;
  transform: rotate(-2deg);
  box-shadow: 0 12rpx 32rpx rgba(74,127,229,.4);
}
.poster-place {
  font-size: 60rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: -1rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 32rpx;
  color: #fff;
  text-shadow: 0 0 48rpx rgba(74,127,229,.55), 0 4rpx 0 rgba(0,0,0,.2);
}
.poster-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  position: relative;
  z-index: 2;
  margin-bottom: 40rpx;
}
.pm-span {
  background: rgba(255,255,255,.1);
  border: 2rpx solid rgba(255,255,255,.16);
  padding: 10rpx 20rpx;
  border-radius: 28rpx;
  font-size: 23rpx;
  font-weight: 700;
  color: #fff;
}
.poster-section {
  position: relative;
  z-index: 2;
  margin-bottom: 36rpx;
}
.ps-title {
  font-size: 26rpx;
  font-weight: 900;
  margin-bottom: 18rpx;
  color: #6B9BF2;
  letter-spacing: 1rpx;
}
.why-line {
  font-size: 26rpx;
  line-height: 1.6;
  color: rgba(255,255,255,.94);
  padding: 18rpx 24rpx;
  margin-bottom: 14rpx;
  background: rgba(255,255,255,.07);
  border-radius: 24rpx;
  border-left: 6rpx solid #4A7FE5;
  font-weight: 500;
}
.hl-chip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.hl-chip {
  background: linear-gradient(135deg, #4A7FE5, #6B9BF2);
  padding: 18rpx 26rpx;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 28rpx rgba(74,127,229,.4);
  transform: rotate(-1.5deg);
}
.hl-chip.alt {
  transform: rotate(1.5deg);
  background: linear-gradient(135deg, #00C9A7, #00E5B0);
  box-shadow: 0 12rpx 28rpx rgba(0,197,167,.4);
}
.hl-chip-name { display: block; font-size: 25rpx; font-weight: 800; color: #fff; }
.hl-chip-tag { display: block; font-size: 20rpx; font-weight: 600; opacity: .9; margin-top: 6rpx; color: #fff; }

.poster-lunar {
  position: relative;
  z-index: 2;
  font-size: 24rpx;
  color: rgba(255,255,255,.6);
  border-top: 2rpx dashed rgba(255,255,255,.16);
  padding-top: 26rpx;
  margin-bottom: 32rpx;
}
.poster-footer {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  border-top: 2rpx solid rgba(255,255,255,.14);
  padding-top: 30rpx;
}
.pf-logo { font-size: 28rpx; font-weight: 900; color: #fff; }
.pf-tip { font-size: 20rpx; color: rgba(255,255,255,.55); text-align: right; max-width: 300rpx; line-height: 1.5; }

.poster-actionbar {
  display: flex;
  gap: 24rpx;
  width: 640rpx;
}
.poster-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 80rpx;
  font-size: 28rpx;
  font-weight: 800;
  border: none;
  margin: 0;
  line-height: 1.2;
}
.poster-btn::after { border: none; }
.poster-btn.ghost {
  background: rgba(255,255,255,.16);
  color: #fff;
  border: 2rpx solid rgba(255,255,255,.32);
}
.poster-btn.solid {
  background: linear-gradient(90deg, #4A7FE5, #6B9BF2);
  color: #fff;
  box-shadow: 0 20rpx 48rpx rgba(74,127,229,.4);
}
