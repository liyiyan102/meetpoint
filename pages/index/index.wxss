/* ================================================================
   约个地儿 · 首页样式 — 完整设计稿重构
   ================================================================ */

/* ---------- 颜色变量 ---------- */
page {
  --primary: #4A7FE5;
  --primary-hover: #3A68C7;
  --bg-color: #F7F9FC;
  --card-bg: #FFFFFF;
  --text-main: #111827;
  --text-sub: #6B7280;
  --text-muted: #9CA3AF;
  --danger: #EF4444;
  --danger-light: #FEF2F2;
  --success: #10B981;
  --border: #F3F4F6;
}

/* ---------- 页面基础 ---------- */
.page {
  min-height: 100vh;
  background: var(--bg-color);
  position: relative;
}

.page-scroll {
  padding: 144rpx 40rpx 280rpx 40rpx;
  box-sizing: border-box;
}

/* 模块间距 */
.section {
  margin-top: 64rpx;
}

/* ---------- 头部信息模块 ---------- */
.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.header-logo {
  width: 144rpx;
  height: 144rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(74, 127, 229, 0.2);
  animation: header-float 3s ease-in-out infinite;
}

@keyframes header-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

.header-title {
  font-size: 56rpx;
  font-weight: 800;
  color: var(--text-main);
  margin-bottom: 12rpx;
}

.header-sub {
  font-size: 28rpx;
  color: var(--text-sub);
  font-weight: 500;
}

/* ---------- 模块标题通用 ---------- */
.section-title {
  display: block;
  font-size: 30rpx;
  color: var(--text-sub);
  font-weight: 600;
  padding-left: 8rpx;
  margin-bottom: 24rpx;
}

/* ---------- 通用卡片基础 ---------- */
.card {
  background: var(--card-bg);
  border-radius: 48rpx;
  border: 2rpx solid var(--border);
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

/* ---------- 我的信息卡片 ---------- */
.profile-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 32rpx;
}

/* 头像容器 */
.avatar-container {
  position: relative;
  width: 128rpx !important;
  height: 128rpx !important;
  flex-shrink: 0;
  padding: 0 !important;
  margin: 0 !important;
  background: transparent;
  border: none;
  overflow: visible;
  line-height: normal;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-container::after {
  border: none;
}

.avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #F3F4F6;
  border: 4rpx solid var(--card-bg);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 编辑徽章 */
.edit-badge {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 52rpx;
  height: 52rpx;
  background: #FFFFFF;
  border: 4rpx solid var(--card-bg);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12);
}

.edit-badge-icon {
  font-size: 24rpx;
  line-height: 1;
}
.edit-badge-icon-img {
  width: 28rpx;
  height: 28rpx;
}

/* 昵称输入框 */
.input-box {
  flex: 1;
  background: #F3F4F6;
  border-radius: 32rpx;
  padding: 0 32rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.input-box-focus {
  background: #FFFFFF;
  border-color: var(--primary);
  box-shadow: 0 0 0 6rpx rgba(74, 127, 229, 0.1);
}

.nickname-input {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
  width: 100%;
  border: none;
  padding: 0;
  margin: 0;
  background: transparent;
}

.input-placeholder {
  color: var(--text-muted);
  font-weight: 400;
}

/* ---------- 进行中的碰头卡片 ---------- */
.active-card {
  position: relative;
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFBFF 100%);
  border-color: #EBF0FA;
  box-shadow: 0 16rpx 48rpx rgba(74, 127, 229, 0.06);
  overflow: hidden;
}

/* 顶部彩条装饰 */
.active-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 8rpx;
  background: linear-gradient(90deg, var(--primary), #8AB4F8);
}

/* 头部：状态标签 + 碰头ID */
.active-header {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.status-tag {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  background: rgba(16, 185, 129, 0.1);
  padding: 8rpx 20rpx;
  border-radius: 200rpx;
}

.pulse-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--success);
  box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.4);
  animation: pulse-spread 1.5s infinite;
}

@keyframes pulse-spread {
  70% {
    box-shadow: 0 0 0 12rpx rgba(16, 185, 129, 0);
  }
  100% {
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0);
  }
}

.status-tag-text {
  font-size: 24rpx;
  color: var(--success);
  font-weight: 600;
}

.meetup-id {
  font-size: 28rpx;
  font-family: 'SF Mono', 'Menlo', 'Courier New', monospace;
  font-weight: 500;
  letter-spacing: 1rpx;
  color: var(--text-muted);
}

/* 发起人 / 碰面地点信息 */
.active-detail-rows {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.active-detail-row {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 16rpx;
}
.active-detail-label {
  font-size: 26rpx;
  color: var(--text-sub);
  width: 104rpx;
  flex-shrink: 0;
}
.active-detail-value {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 信息区：头像层叠 + 人数 */
.active-info {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.avatar-stack {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.stack-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  background: #F3F4F6;
  position: relative;
}

.stack-more {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--border);
  border: 4rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.stack-more-text {
  font-size: 20rpx;
  color: var(--text-sub);
  font-weight: 600;
}

.active-count {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-main);
}

.active-count-num {
  color: var(--primary);
  font-weight: 600;
}

/* 操作按钮组 */
.active-actions {
  display: flex;
  flex-direction: row;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 88rpx;
}
.btn::after {
  border: none;
}

.btn-continue {
  background: var(--primary);
  color: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(74, 127, 229, 0.25);
}
.btn-continue:active {
  background: var(--primary-hover);
}

.btn-end {
  background: #FFFFFF;
  color: var(--danger);
  border: 2rpx solid rgba(239, 68, 68, 0.3);
}
.btn-end-hover {
  background: var(--danger-light);
}

/* ---------- 底部行动召唤区 ---------- */
.bottom-anchor {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 48rpx 48rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(247, 249, 252, 0) 0%, #F7F9FC 20%, #F7F9FC 100%);
  z-index: 20;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.btn-launch {
  width: 100%;
  height: 112rpx;
  border-radius: 56rpx;
  background: var(--primary);
  color: #FFFFFF;
  font-size: 36rpx;
  font-weight: 600;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(74, 127, 229, 0.2);
  line-height: 112rpx;
  margin-bottom: 24rpx;
}
.btn-launch::after {
  border: none;
}
.btn-launch:active {
  background: var(--primary-hover);
  box-shadow: 0 8rpx 24rpx rgba(74, 127, 229, 0.3);
}
.btn-launch-icon {
  width: 40rpx;
  height: 40rpx;
  vertical-align: middle;
  margin-right: 8rpx;
}

.bottom-text {
  font-size: 24rpx;
  color: var(--text-muted);
  text-align: center;
}

.active-info-right {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

/* ================================================================
   底部按钮未授权态（引导选头像/填昵称）
   ================================================================ */
/* 未授权按钮 hint 文案样式 */
.btn-launch-hint {
  background: #F59E0B !important;  /* 琥珀色提示 */
  box-shadow: 0 8rpx 24rpx rgba(245, 158, 11, 0.3) !important;
}
.btn-launch-hint:active {
  background: #D97706 !important;
}

/* 昵称输入框高亮闪烁 */
@keyframes nickname-pulse {
  0%, 100% { box-shadow: 0 0 0 6rpx rgba(245, 158, 11, 0.1); }
  50% { box-shadow: 0 0 0 12rpx rgba(245, 158, 11, 0.3); }
}
.input-box-highlight {
  background: #FFFBEB !important;
  border: 2rpx solid #F59E0B !important;
  animation: nickname-pulse 1s ease-in-out infinite;
}

/* ================================================================
   首次进入：产品特性介绍卡片
   ================================================================ */
.feature-card {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
}
.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}
.feature-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #EFF6FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.feature-icon-plus {
  font-size: 48rpx;
  font-weight: 600;
  color: #3B82F6;
  line-height: 1;
}
.feature-icon-img {
  width: 44rpx;
  height: 44rpx;
}
.feature-texts {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding-top: 4rpx;
  min-width: 0;
}
.feature-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}
.feature-desc {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
}
