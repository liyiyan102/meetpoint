<!-- 约个地儿 · 首页 -->
<view class="page">

  <!-- ========== 主滚动区域 ========== -->
  <view class="page-scroll">

    <!-- ========== 头部信息模块 ========== -->
    <view class="header">
      <image class="header-logo" src="../../images/logo.png" mode="aspectFit" bindlongpress="onDevReset" />
      <text class="header-title">约个地儿</text>
      <text class="header-sub">多人实时位置 · 智能推荐碰头地点</text>
    </view>

    <!-- ========== 首次进入：产品特性介绍卡片（未设置头像&昵称时展示） ========== -->
    <view class="section" wx:if="{{!avatarUrl && !nickname}}">
      <view class="card feature-card">
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <text class="feature-icon-plus">+</text>
          </view>
          <view class="feature-texts">
            <text class="feature-title">一键发起碰头</text>
            <text class="feature-desc">无需注册登录，点击底部按钮即可极速创建碰头房间。</text>
          </view>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <image class="feature-icon-img" src="/images/icons/icon-share.svg" mode="aspectFit"></image>
          </view>
          <view class="feature-texts">
            <text class="feature-title">微信邀请好友</text>
            <text class="feature-desc">将房间链接发送给微信好友，对方点击即可加入。</text>
          </view>
        </view>
        <view class="feature-item">
          <view class="feature-icon-wrap">
            <image class="feature-icon-img" src="/images/icons/icon-recommend.svg" mode="aspectFit"></image>
          </view>
          <view class="feature-texts">
            <text class="feature-title">智能推荐地点</text>
            <text class="feature-desc">自动根据所有人的实时位置，计算并推荐最公平的中间点。</text>
          </view>
        </view>
      </view>
    </view>

    <!-- ========== 我的信息卡片（首次进入无头像+无昵称时不展示，授权后才出现） ========== -->
    <view class="section" wx:if="{{avatarUrl || nickname}}">
      <text class="section-title">我的信息</text>
      <view class="card profile-card">
        <button class="avatar-container" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image
            class="avatar-img"
            src="{{avatarUrl || defaultAvatar}}"
            mode="aspectFill"
          />
          <view class="edit-badge">
            <image class="edit-badge-icon-img" src="/images/icons/icon-camera.svg" mode="aspectFit"></image>
          </view>
        </button>
        <view class="input-box {{inputFocused ? 'input-box-focus' : ''}} {{nicknameHighlight ? 'input-box-highlight' : ''}}">
          <input
            class="nickname-input"
            type="nickname"
            placeholder="设置你的昵称"
            placeholder-class="input-placeholder"
            value="{{nickname}}"
            focus="{{nicknameFocus}}"
            bindinput="onNicknameInput"
            bindblur="onNicknameBlur"
            bindfocus="onNicknameFocus"
          />
        </view>
      </view>
    </view>

    <!-- ========== 进行中的碰头卡片 ========== -->
    <view class="section" wx:if="{{activeMeeting}}">
      <text class="section-title">进行中的碰头</text>
      <view class="card active-card">
        <!-- 顶部彩条装饰（CSS ::before 实现） -->
        <view class="active-header">
          <view class="status-tag">
            <view class="pulse-dot"></view>
            <text class="status-tag-text">进行中</text>
          </view>
        </view>

        <!-- 信息区 -->
        <view class="active-info">
          <view class="active-detail-rows">
            <view class="active-detail-row" wx:if="{{activeMeeting.creatorName}}">
              <text class="active-detail-label">发起人</text>
              <text class="active-detail-value">{{activeMeeting.creatorName}}</text>
            </view>
            <view class="active-detail-row" wx:if="{{activeMeeting.meetPointName}}">
              <text class="active-detail-label">碰面地点</text>
              <text class="active-detail-value">{{activeMeeting.meetPointName}}</text>
            </view>
          </view>
          <view class="active-info-right">
            <view class="avatar-stack">
              <image
                class="stack-avatar"
                wx:for="{{activeMeeting.members}}"
                wx:key="userId"
                wx:if="{{index < 5}}"
                style="margin-left: {{index === 0 ? '0' : '-20rpx'}}; z-index: {{10 - index}};"
                src="{{item.avatarUrl || defaultAvatar}}"
                mode="aspectFill"
              />
              <view class="stack-more" wx:if="{{activeMeeting.totalCount > 5}}" style="margin-left: -20rpx;">
                <text class="stack-more-text">+{{activeMeeting.totalCount - 5}}</text>
              </view>
            </view>
            <text class="active-count">
              <text class="active-count-num">{{activeMeeting.totalCount || activeMeeting.members.length}}</text> 人参与
            </text>
          </view>
        </view>

        <!-- 操作按钮 -->
        <view class="active-actions">
          <button class="btn btn-continue" bindtap="onResumeMeeting">
            继续碰头
          </button>
          <button class="btn btn-end" hover-class="btn-end-hover" bindtap="onEndOrLeaveMeeting">
            {{isCreator ? '结束' : '退出'}}
          </button>
        </view>
      </view>
    </view>

  </view>

  <!-- ========== 底部行动召唤区（固定定位） ========== -->
  <view class="bottom-anchor" wx:if="{{!activeMeeting}}">
    <!-- 未授权 & 没头像：按钮 = chooseAvatar 原生按钮，点它直接调起微信选择头像菜单 -->
    <button
      wx:if="{{!avatarUrl}}"
      class="btn-launch"
      open-type="chooseAvatar"
      bindchooseavatar="onLaunchChooseAvatar">
      发起碰头
    </button>
    <!-- 已有头像但无昵称：按钮变成「请先设昵称」提示，bindtap 聚焦顶部昵称输入框 -->
    <button
      wx:elif="{{!nickname}}"
      class="btn-launch btn-launch-hint"
      bindtap="onLaunchNeedNickname">
      请先设置昵称
    </button>
    <!-- 已有头像和昵称：正常发起碰头 -->
    <button
      wx:else
      class="btn-launch"
      bindtap="onCreateMeeting">
      发起碰头
    </button>
    <text class="bottom-text">{{!avatarUrl ? '点按钮先选个头像，好友才能在地图上看到你' : (!nickname ? '头像已设置，请在上方输入昵称' : '发起后分享链接给好友，即可开始碰头')}}</text>
  </view>

</view>
